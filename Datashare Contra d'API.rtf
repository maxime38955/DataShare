openapi: 3.0.3\
info:\
  title: DataShare API\
  description: API Backend pour le partage de fichiers s\'e9curis\'e9s (MVP)\
  version: 1.0.0\
servers:\
  - url: http://localhost:8080\
    description: Serveur Local\
components:\
  securitySchemes:\
    bearerAuth:\
      type: http\
      scheme: bearer\
      bearerFormat: JWT\
  schemas:\
    LoginRequest:\
      type: object\
      properties:\
        email:\
          type: string\
          example: user@datashare.com\
        password:\
          type: string\
          example: password123\
    RegisterRequest:\
      type: object\
      properties:\
        email:\
          type: string\
          example: newuser@datashare.com\
        password:\
          type: string\
          example: password123\
    AuthResponse:\
      type: object\
      properties:\
        token:\
          type: string\
        email:\
          type: string\
        message:\
          type: string\
    FileResponseDTO:\
      type: object\
      properties:\
        fileId:\
          type: integer\
        name:\
          type: string\
        size:\
          type: integer\
        mimeType:\
          type: string\
        token:\
          type: string\
        uploadDate:\
          type: string\
          format: date-time\
        expirationDate:\
          type: string\
          format: date-time\
        isActive:\
          type: boolean\
\
paths:\
  /user/register:\
    post:\
      summary: Inscrire un nouvel utilisateur\
      tags: [Utilisateurs]\
      requestBody:\
        required: true\
        content:\
          application/json:\
            schema:\
              $ref: '#/components/schemas/RegisterRequest'\
      responses:\
        '201':\
          description: Compte cr\'e9\'e9 avec succ\'e8s\
          content:\
            application/json:\
              schema:\
                $ref: '#/components/schemas/AuthResponse'\
        '400':\
          description: Requ\'eate invalide (ex. mot de passe trop court)\
\
  /user/login:\
    post:\
      summary: Authentifier un utilisateur\
      tags: [Utilisateurs]\
      requestBody:\
        required: true\
        content:\
          application/json:\
            schema:\
              $ref: '#/components/schemas/LoginRequest'\
      responses:\
        '200':\
          description: Connexion r\'e9ussie\
          content:\
            application/json:\
              schema:\
                $ref: '#/components/schemas/AuthResponse'\
        '401':\
          description: Identifiants incorrects\
\
  /files/upload:\
    post:\
      summary: Uploader un nouveau fichier\
      tags: [Fichiers]\
      security:\
        - bearerAuth: []\
      requestBody:\
        required: true\
        content:\
          multipart/form-data:\
            schema:\
              type: object\
              properties:\
                file:\
                  type: string\
                  format: binary\
                password:\
                  type: string\
                expirationDays:\
                  type: integer\
                  default: 7\
                tags:\
                  type: array\
                  items:\
                    type: string\
      responses:\
        '201':\
          description: Fichier upload\'e9 avec succ\'e8s\
          content:\
            application/json:\
              schema:\
                $ref: '#/components/schemas/FileResponseDTO'\
\
  /files/user/files:\
    get:\
      summary: R\'e9cup\'e9rer l'historique des fichiers de l'utilisateur\
      tags: [Fichiers]\
      security:\
        - bearerAuth: []\
      responses:\
        '200':\
          description: Liste des fichiers\
          content:\
            application/json:\
              schema:\
                type: array\
                items:\
                  $ref: '#/components/schemas/FileResponseDTO'\
\
  /files/metadata/\{token\}:\
    get:\
      summary: Obtenir les m\'e9tadonn\'e9es publiques d'un fichier\
      tags: [Fichiers]\
      parameters:\
        - name: token\
          in: path\
          required: true\
          schema:\
            type: string\
      responses:\
        '200':\
          description: M\'e9tadonn\'e9es du fichier\
          content:\
            application/json:\
              schema:\
                $ref: '#/components/schemas/FileResponseDTO'\
        '404':\
          description: Fichier non trouv\'e9\
\
  /files/download/\{token\}:\
    get:\
      summary: T\'e9l\'e9charger un fichier\
      tags: [Fichiers]\
      parameters:\
        - name: token\
          in: path\
          required: true\
          schema:\
            type: string\
        - name: password\
          in: query\
          required: false\
          schema:\
            type: string\
      responses:\
        '200':\
          description: Le flux du fichier binaire\
          content:\
            application/octet-stream:\
              schema:\
                type: string\
                format: binary\
        '401':\
          description: Mot de passe requis mais manquant\
        '403':\
          description: Mot de passe incorrect\
        '404':\
          description: Fichier non trouv\'e9\
\
  /files/user/\{fileId\}:\
    delete:\
      summary: Supprimer un fichier manuellement\
      tags: [Fichiers]\
      security:\
        - bearerAuth: []\
      parameters:\
        - name: fileId\
          in: path\
          required: true\
          schema:\
            type: integer\
      responses:\
        '200':\
          description: Fichier supprim\'e9\
        '403':\
          description: Non autoris\'e9 \'e0 supprimer ce fichier\
        '404':\
          description: Fichier non trouv\'e9}